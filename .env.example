# Production Environment Variables for OSCE Live
# Vercel Project Settings -> Environment Variables

# 1. Supabase Database & Auth (Google OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Google Cloud / Gemini AI Brain (Gemini 3.8 Flash, Cloud STT, Cloud TTS)
GOOGLE_API_KEY=your-google-cloud-api-key

# 3. Google Cloud Run Ultra-Low Latency Streaming Voice WebSocket Endpoint
# (Deploys via server/deploy-cloud-run.sh with --min-instances 0 for scale-to-zero)
VITE_VOICE_STREAMING_URL=wss://brightmed-voice-service-xxxx.a.run.app/live-osce

